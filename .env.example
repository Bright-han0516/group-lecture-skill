# Optional environment overrides. Copy to .env and source it, or export directly.
# scripts/build_topic.sh reads these; the scaffold copies fonts/texmf so most
# topics need no overrides at all.

# Course root that holds _模板/ and topic directories.
GLB_ROOT=/path/to/course/IB/集团讲义

# Advanced overrides (normally unnecessary):
# GLB_TEMPLATE_DIR=/path/to/course/IB/集团讲义/_模板
# GLB_FONTS_DIR=/path/to/repo/template/fonts
# GLB_TEXMF=/path/to/repo/vendor/texmf
# GLB_SLUG=A3_Energy
# XELATEX=/usr/local/texlive/2026/bin/universal-darwin/xelatex
